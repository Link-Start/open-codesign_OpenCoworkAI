{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codesign:v04:cost-event:draft-1",
  "title": "v04 prospective cost event (draft-not-frozen)",
  "$comment": "Local schema, no network lookup. Null means not measured; zero needs evidence. Public records must not reveal heldout cases. Timestamps delimit observed windows, not active human labor.",
  "type": "object", "additionalProperties": false,
  "required": ["eventId", "protocolStatus", "actor", "phase", "activity", "visibility", "allocation", "origin", "status", "parentEventId", "startedAt", "endedAt", "timeBasis", "wallSeconds", "activeHumanSeconds", "cpuSeconds", "peakMemoryBytes", "experimentApiAttempts", "authoringModelAttempts", "inputTokens", "outputTokens", "cachedInputTokens", "money", "artifacts", "dependencies", "evidence", "limitations"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "protocolStatus": {"enum": ["draft-not-frozen", "frozen", "deferred"]},
    "actor": {"type": "string", "minLength": 1},
    "phase": {"enum": ["protocol", "development", "measurement", "pilot", "freeze", "formal", "audit", "maintenance"]},
    "activity": {"type": "string", "minLength": 1},
    "visibility": {"enum": ["public", "private"]},
    "allocation": {"enum": ["shared-research", "react-product", "measurement", "external-baseline", "instrumentation", "authoring", "mixed-unallocated"]},
    "origin": {"enum": ["new", "inherited", "adaptation", "mixed"]},
    "status": {"enum": ["open", "completed", "interrupted", "failed"]},
    "parentEventId": {"type": ["string", "null"]},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "endedAt": {"type": ["string", "null"], "format": "date-time"},
    "timeBasis": {"enum": ["observed-window", "direct-active-timer", "historical-unmeasured"]},
    "wallSeconds": {"$ref": "#/$defs/nonnegativeNullable"},
    "activeHumanSeconds": {"$ref": "#/$defs/nonnegativeNullable"},
    "cpuSeconds": {"$ref": "#/$defs/nonnegativeNullable"},
    "peakMemoryBytes": {"$ref": "#/$defs/integerNullable"},
    "experimentApiAttempts": {"$ref": "#/$defs/integerNullable"},
    "authoringModelAttempts": {"$ref": "#/$defs/integerNullable"},
    "inputTokens": {"$ref": "#/$defs/integerNullable"},
    "outputTokens": {"$ref": "#/$defs/integerNullable"},
    "cachedInputTokens": {"$ref": "#/$defs/integerNullable"},
    "money": {
      "type": "object", "additionalProperties": false, "required": ["amount", "currency", "basis"],
      "properties": {
        "amount": {"$ref": "#/$defs/nonnegativeNullable"},
        "currency": {"type": ["string", "null"]},
        "basis": {"enum": ["invoice", "provider-receipt", "estimated-with-rate-evidence", "unknown"]}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "version", "sha256"], "properties": {"path": {"type": "string"}, "version": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}}}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "costTreatment"], "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]}, "costTreatment": {"type": "string"}}}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "nonnegativeNullable": {"type": ["number", "null"], "minimum": 0},
    "integerNullable": {"type": ["integer", "null"], "minimum": 0}
  },
  "x-invariants": [
    "When both timestamps are known, endedAt >= startedAt and wallSeconds reflects only that observed window",
    "Open event endedAt/wallSeconds may be null; unknown historical time is not inferred",
    "cachedInputTokens <= inputTokens when both known and is already included, never added twice",
    "Unknown authoring usage/money/active labor remains null; experimentApiAttempts=0 does not imply no authoring cost",
    "Do not sum nested or overlapping wall intervals as total elapsed; aggregate by appropriate event scope",
    "Artifact self-hash is not fabricated; use an external manifest if needed",
    "Private per-case cost evidence never enters public logs before authorized release"
  ]
}
